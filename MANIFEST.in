include LICENSE CITATION.cff README.md CONTRIBUTING.md CONTRIBUTING.zh-CN.md
include CITING.md CITATION.bib
include THIRD_PARTY.md ROADMAP.md DECISIONS.md .gitignore
include CHANGELOG.md
include *.command
recursive-include .github *.yml
recursive-include research/notes *.md
include results/pt111-validation.json
include results/pt3y-validation.json
include results/release-checks-v02.json
include results/pt3y-bader-gridcheck.json results/pt3y-bader-refinement.json results/pt3y-bader-reference-check.json
