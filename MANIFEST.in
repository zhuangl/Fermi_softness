recursive-include validation *.py
include validation/public-fixtures.json
recursive-include validation/pt111 INCAR POSCAR KPOINTS *.md
recursive-include validation/pt3y111 INCAR.relax POSCAR.initial KPOINTS *.md
prune validation/data
prune research/private
prune results/local
